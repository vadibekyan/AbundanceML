    "def evaluate_on_test_data(X_train, y_train, test_df, target, models, test_name='Test'):\n",
    "    \"\"\"\n",
    "    Trains models on the full training set and evaluates on a test set.\n",
    "\n",
    "    Parameters:\n",
    "        X_train, y_train: Training features and target.\n",
    "        test_df: DataFrame containing the test data (including the target column).\n",
    "        target (str): Name of the target column in test_df.\n",
    "        models: Dictionary of model_name: model_instance.\n",
    "        test_name (str): Label for this test set (e.g., 'Apogee', 'HARPS').\n",
    "\n",
    "    Returns:\n",
    "        dict: model_name → test MAE and baseline MAE\n",
    "    \"\"\"\n",
    "    X_test = test_df.drop(columns=[target])\n",
    "    y_test = test_df[target]\n",
    "\n",
    "    results = {}\n",
    "\n",
    "    for name, model in models.items():\n",
    "        print(f\"Training and evaluating {name} on {test_name}\")\n",
    "        model.fit(X_train, y_train)\n",
    "\n",
    "        y_pred = model.predict(X_test)\n",
    "\n",
    "        mae_model = mean_absolute_error(y_test, y_pred)\n",
    "        mae_baseline = mean_absolute_error(y_test, [y_test.mean()] * len(y_test))\n",
    "\n",
    "        results[name] = {\n",
    "            'mae_model': mae_model,\n",
    "            'mae_baseline': mae_baseline\n",
    "        }\n",
    "\n",
    "        print(f\"{name} | {test_name} MAE: {mae_model:.3f} (mean baseline: {mae_baseline:.3f})\\n\")\n",
    "\n",
    "    return results\n"
   ]
