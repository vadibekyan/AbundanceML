    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def plot_residuals_vs_true(y_true, y_pred, model_name='Model', sample_name='Test Set'):\n",
    "    \"\"\"\n",
    "    Plot residuals (y_true - y_pred) vs y_true, and residuals from predicting the mean.\n",
    "\n",
    "    Parameters:\n",
    "        y_true: Ground truth target values.\n",
    "        y_pred: Model predictions.\n",
    "        model_name: Name of the model for labeling.\n",
    "        sample_name: Name of the dataset (e.g., 'Apogee' or 'HARPS').\n",
    "    \"\"\"\n",
    "    y_true = np.array(y_true)\n",
    "    y_pred = np.array(y_pred)\n",
    "    y_mean = np.full_like(y_true, y_true.mean())\n",
    "\n",
    "    residuals_model = y_true - y_pred\n",
    "    residuals_mean = y_true - y_mean\n",
    "\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.scatter(y_true, residuals_model, alpha=0.6, label=f'{model_name}', s=20)\n",
    "    plt.scatter(y_true, residuals_mean, alpha=0.4, label='Mean predictor', s=20, marker='x')\n",
    "\n",
    "    plt.axhline(0, color='gray', linestyle='--')\n",
    "    plt.xlabel('True Value (y)')\n",
    "    plt.ylabel('Residual (y_true - y_pred)')\n",
    "    plt.title(f'Residuals vs True Values ({sample_name})')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
