    "def fit_trasform(X):\n",
    "    X['VW_lsr'] = np.sqrt(X['V_lsr']**2 + X['W_lsr']**2)\n",
    "    X['UW_lsr'] = np.sqrt(X['U_lsr']**2 + X['W_lsr']**2)\n",
    "    X['UV_lsr'] = np.sqrt(X['U_lsr']**2 + X['V_lsr']**2)\n",
    "    X['UVW_lsr'] = np.sqrt(X['U_lsr']**2 + X['V_lsr']**2 + X['W_lsr']**2)\n",
    "    epsilon = 1e-6\n",
    "    #log features\n",
    "    #X['Log_RV'] = np.log(X['RV'] + np.abs(X['RV'].min()))\n",
    "    X['Log_U_lsr'] = np.log(X['U_lsr'] + np.abs(X['U_lsr'].min()) + epsilon)\n",
    "    X['Log_V_lsr'] = np.log(X['V_lsr'] + np.abs(X['V_lsr'].min()) + epsilon)\n",
    "    X['Log_W_lsr'] = np.log(X['W_lsr'] + np.abs(X['W_lsr'].min()) + epsilon)\n",
    "    X['Log_UW_lsr'] = np.log(X['UW_lsr'])\n",
    "    X['Log_UVW_lsr'] = np.log(X['UVW_lsr'])\n",
    "\n",
    "    return X\n",
    "\n",
    "apogee = fit_trasform(apogee)\n",
    "harps = fit_trasform(harps)\n",
    "galah = fit_trasform(galah)\n",
    "gr8 = fit_trasform(gr8)"
   ]
