    "def plot_residuals_vs_features(X, y_true, y_pred, feature_names=None, model_name='Model', sample_name='Test Set'):\n",
    "    \"\"\"\n",
    "    Plot residuals (y_true - y_pred) vs each feature in X.\n",
    "\n",
    "    Parameters:\n",
    "        X: DataFrame or array of features.\n",
    "        y_true: True target values.\n",
    "        y_pred: Predicted target values.\n",
    "        feature_names: Optional list of feature names.\n",
    "        model_name: For labeling plots.\n",
    "        sample_name: Dataset name for titles.\n",
    "    \"\"\"\n",
    "    import matplotlib.pyplot as plt\n",
    "    import numpy as np\n",
    "    import pandas as pd\n",
    "\n",
    "    if isinstance(X, np.ndarray):\n",
    "        X = pd.DataFrame(X, columns=feature_names if feature_names else [f'feature_{i}' for i in range(X.shape[1])])\n",
    "\n",
    "    residuals = np.array(y_true) - np.array(y_pred)\n",
    "\n",
    "    num_features = X.shape[1]\n",
    "    ncols = 3\n",
    "    nrows = int(np.ceil(num_features / ncols))\n",
    "\n",
    "    fig, axes = plt.subplots(nrows=nrows, ncols=ncols, figsize=(5 * ncols, 4 * nrows))\n",
    "\n",
    "    for idx, col in enumerate(X.columns):\n",
    "        ax = axes.flatten()[idx]\n",
    "        ax.scatter(X[col], residuals, alpha=0.6, s=20)\n",
    "        ax.axhline(0, color='gray', linestyle='--')\n",
    "        ax.set_xlabel(col)\n",
    "        ax.set_ylabel('Residual')\n",
    "        ax.set_title(f'{col} vs Residual')\n",
    "\n",
    "    for j in range(idx + 1, nrows * ncols):\n",
    "        fig.delaxes(axes.flatten()[j])  # Remove empty subplots\n",
    "\n",
    "    fig.suptitle(f'{model_name} Residuals vs Features ({sample_name})', fontsize=16)\n",
    "    plt.tight_layout(rect=[0, 0.03, 1, 0.95])\n",
    "    plt.show()\n"
   ]
