    "def model_test_CV_models(X, y, models, k=5, random_state=random_state):\n",
    "    \"\"\"\n",
    "    Perform k-fold cross-validation for multiple models and return mean MAE scores and elapsed time.\n",
    "\n",
    "    Parameters:\n",
    "        X (DataFrame): Feature matrix.\n",
    "        y (Series): Target vector.\n",
    "        models (dict): Dictionary of model_name: model_instance.\n",
    "        k (int): Number of folds.\n",
    "        random_state (int): Seed for reproducibility.\n",
    "\n",
    "    Returns:\n",
    "        dict: {model_name: {'mean_mae': ..., 'std_mae': ..., 'time_sec': ...}}\n",
    "    \"\"\"\n",
    "    kf = KFold(n_splits=k, shuffle=True, random_state=random_state)\n",
    "    results = {}\n",
    "\n",
    "    for name, model in models.items():\n",
    "        print(f\"Scoring model: {name}\")\n",
    "        start_time = time.time()\n",
    "        mae_scores = []\n",
    "\n",
    "        for train_index, test_index in kf.split(X, y):\n",
    "            X_train, X_test = X.iloc[train_index], X.iloc[test_index]\n",
    "            y_train, y_test = y.iloc[train_index], y.iloc[test_index]\n",
    "\n",
    "            # Special handling for scikeras models\n",
    "            if isinstance(model, KerasRegressor):\n",
    "                model.set_params(model__input_dim=X_train.shape[1])\n",
    "\n",
    "            model.fit(X_train, y_train)\n",
    "            y_pred = model.predict(X_test)\n",
    "            mae = mean_absolute_error(y_test, y_pred)\n",
    "            mae_scores.append(mae)\n",
    "\n",
    "        elapsed_time = time.time() - start_time\n",
    "        results[name] = {\n",
    "            'mean_mae': np.mean(mae_scores),\n",
    "            'std_mae': np.std(mae_scores),\n",
    "            'time_sec': elapsed_time\n",
    "        }\n",
    "\n",
    "        print(f\"{name} done in {elapsed_time:.2f}s → MAE: {results[name]['mean_mae']:.3f} ± {results[name]['std_mae']:.3f}\\n\")\n",
    "\n",
    "    return results\n"
   ]
